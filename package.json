{
  "name": "snaix-docs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "content:setup": "bash scripts/setup-content.sh",
    "dev": "bun --filter './apps/site' dev",
    "build": "bun --filter './apps/site' build",
    "preview": "bun --filter './apps/site' preview",
    "typecheck": "tsc --noEmit -p packages/astro-integration/tsconfig.json && tsc --noEmit -p packages/theme/tsconfig.json && tsc --noEmit -p apps/site/tsconfig.json && tsc --noEmit -p apps/example/tsconfig.json",
    "check:site": "python3 scripts/check-built-site.py"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.8.2",
    "libsodium-wrappers": "^0.8.4",
    "typescript": "^5.6.3",
    "yaml": "^2.8.3",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.5"
  },
  "packageManager": "bun@1.3.13"
}
