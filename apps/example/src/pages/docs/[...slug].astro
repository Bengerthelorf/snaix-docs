---
import { getCollection } from 'astro:content';
import DocsLayout from '@snaix/docs-theme/layouts/DocsLayout.astro';
import { buildDocsNav } from '@snaix/docs/docs-nav';
import { snaixConfig } from 'virtual:snaix-config';

const product = snaixConfig.products[0]!;

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const all = await getCollection('docs');
const locale = snaixConfig.locales[0]!;
const nav = buildDocsNav(all, { locale, locales: snaixConfig.locales });

const { Content, headings } = await entry.render();

const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ slug: h.slug, text: h.text, depth: h.depth }));

const breadcrumb = ['docs', entry.data.section ?? 'guide', entry.data.title];
---
<DocsLayout
  product={product}
  brand={product.title}
  version={product.version}
  current={entry.slug}
  nav={nav}
  title={entry.data.title}
  description={entry.data.description}
  breadcrumb={breadcrumb}
  toc={toc}
  source={{ path: `docs/${entry.slug}.md` }}
  topNav={product.tabs}
  pagerLocale={locale}
>
  <Content />
</DocsLayout>
