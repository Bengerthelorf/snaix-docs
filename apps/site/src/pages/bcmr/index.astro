---
import WorkbenchEntry from '../../components/workbench/WorkbenchEntry.astro';
import DefaultLayout from '@snaix/docs-theme/layouts/DefaultLayout.astro';
import TopBar from '@snaix/docs-theme/components/TopBar.astro';
import Footer from '@snaix/docs-theme/components/Footer.astro';
import {
  BlockReveal,
  Scramble,
  Tally,
  Typewriter,
  CommandStream,
} from '@snaix/docs-theme';
import type { CmdLine } from '@snaix/docs-theme';
import { product } from '../../lib/product.ts';

const bcmrProduct = product('bcmr');

const terminalScript: CmdLine[] = [
  { type: 'prompt', text: 'bcmr copy -r -V ./dataset/ ~/Backup/' },
  { type: 'blank' },
  { type: 'prompt', text: 'bcmr copy -r -V ./dataset/ user@node-04:/srv/' },
  { type: 'blank' },
  { type: 'prompt', text: 'bcmr copy -C -V ./big.iso user@node-04:/iso/' },
];

const features = [
  { n: '01', t: 'BLAKE3 verification', d: '--verify compares the source and copied data with BLAKE3.', mark: 'sq', color: 'var(--ink)' },
  { n: '02', t: 'validated resume', d: '--resume checks the saved prefix against source and destination before reusing it.', mark: 'ci', color: 'var(--red)' },
  { n: '03', t: 'local + SSH', d: 'Use the same copy syntax for local disks, uploads and downloads.', mark: 'tr', color: 'var(--blue)' },
  { n: '04', t: 'reflink + sparse', d: 'Use copy-on-write clones and sparse output on supported filesystems.', mark: 'sq', color: 'var(--yellow)' },
  { n: '05', t: 'compression + dedup', d: 'Zstd/LZ4 wire compression; Linux/macOS serve caches reuse blocks in uploads ≥16 MiB.', mark: 'ci', color: 'var(--ink)' },
  { n: '06', t: 'JSON + progress', d: '--json emits NDJSON events. --progress tui displays transfer progress in the terminal.', mark: 'tr', color: 'var(--red)' },
] as const;
---
<DefaultLayout title="bcmr — copy, verify and resume" description="Copy files locally or over SSH. Verify content with BLAKE3 and resume interrupted transfers.">
  <div class="page home">
    <TopBar
      brand={bcmrProduct.title}
      version={bcmrProduct.version}
      current="home"
      githubHref={bcmrProduct.githubUrl}
      nav={bcmrProduct.nav()}
    />

    <WorkbenchEntry href="/workbench/commands/" label="Build a bcmr command" description="Set paths and flags, then copy the command." />

    <section class="hero">
      <div class="hero-top rule-b">
        <span class="t-mono-sm">bcmr / copy · move · remove</span>
        <span class="t-mono-sm">local files + SSH transfers</span>
        <span class="t-mono-sm">{bcmrProduct.version} · {bcmrProduct.releaseDate}</span>
      </div>

      <div class="hero-grid grid12">
        <div class="hero-headline">
          <div class="hero-eyebrow">
            <span class="t-small">§ 01 · overview</span>
            <span class="t-mono-sm" style="color: var(--steel-5);">
              <Typewriter client:visible text="// BLAKE3 verification · resumable transfers" speed={24} delay={300} />
            </span>
          </div>
          <h1 class="t-display lower">
            <span class="hl-line"><BlockReveal client:visible delay={400} duration={520}>copy.</BlockReveal></span>
            <span class="hl-line"><BlockReveal client:visible delay={760} duration={520} color="var(--red)">move.</BlockReveal></span>
            <span class="hl-line"><BlockReveal client:visible delay={1120} duration={520} color="var(--blue)">remove.</BlockReveal></span>
          </h1>

          <p class="hero-lede">
            Copy files locally or over SSH. Check content with BLAKE3,
            resume partial transfers and track progress from one CLI.
          </p>

          <div class="hero-cta">
            <a class="btn-block" href={bcmrProduct.href('/install')}>↳ install {bcmrProduct.version}</a>
            <a class="btn-block is-ghost" href={bcmrProduct.href('/docs/getting-started')}>read the docs</a>
            <span class="hero-cta-meta t-mono-sm">
              ⌘ <span>brew install Bengerthelorf/tap/bcmr</span>
            </span>
          </div>
        </div>

        <aside class="hero-device">
          <div class="device-head">
            <div class="t-small">transfer · example</div>
            <div class="chip is-blue"><span class="dot"/>--verify</div>
          </div>
          <div style="padding: 16px; background: var(--c-ink-0); color: var(--c-paper-pure); font-family: var(--mono); font-size: 12px; line-height: 1.7;">
            <div style="color: var(--c-steel-5);"># 14.2 gb · local → ssh</div>
            <div>src  <b style="color: var(--c-paper-pure);">./dataset/</b></div>
            <div>dst  <b style="color: var(--c-paper-pure);">user@node-04:/srv/</b></div>
            <div style="margin: 10px 0; color: var(--c-steel-3);">────────────────</div>
            <div>hash <span style="color: var(--c-blue-dim);">BLAKE3</span> · readback</div>
            <div>mode <span style="color: var(--c-yellow);">--resume</span></div>
            <div>conn SSH · <span style="color: var(--c-yellow);"><Tally client:visible to={4} duration={700} /></span> workers</div>
            <div style="margin-top: 10px; background: var(--c-steel-9); height: 6px; position: relative; overflow: hidden;">
              <div style="position: absolute; inset: 0; right: 18%; background: var(--c-blue-dim);" />
            </div>
            <div style="margin-top: 6px; display: flex; justify-content: space-between; color: var(--c-steel-5);">
              <span>82%</span><span>11.6 / 14.2 gb</span>
            </div>
          </div>
          <div class="device-footline">
            <span class="t-mono-sm">SSH · parallel connections</span>
            <span class="t-mono-sm" style="color: var(--blue);">● demo</span>
          </div>
        </aside>
      </div>

      <div class="hero-ribbon rule-t">
        <div class="ribbon-item">
          <div class="ribbon-head">
            <span class="t-small">01</span>
            <span class="ribbon-label"><Scramble client:visible text="content verification" delay={200} /></span>
          </div>
          <div class="ribbon-sub">Compare copied files by hash.</div>
        </div>
        <div class="ribbon-item">
          <div class="ribbon-head">
            <span class="t-small">02</span>
            <span class="ribbon-label"><Scramble client:visible text="partial-file resume" delay={350} /></span>
          </div>
          <div class="ribbon-sub">Reuse data from interrupted transfers.</div>
        </div>
        <div class="ribbon-item">
          <div class="ribbon-head">
            <span class="t-small">03</span>
            <span class="ribbon-label"><Scramble client:visible text="local + SSH" delay={500} /></span>
          </div>
          <div class="ribbon-sub">Upload or download with user@host:/path/.</div>
        </div>
        <div class="ribbon-item">
          <div class="ribbon-head">
            <span class="t-small">04</span>
            <span class="ribbon-label"><Scramble client:visible text="preview changes" delay={650} /></span>
          </div>
          <div class="ribbon-sub">--dry-run lists planned operations.</div>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="section-head">
        <div class="section-head-left">
          <div class="t-small">§ 02 · one cli</div>
          <h2 class="t-h1 lower">local files.<br/>remote paths.</h2>
        </div>
        <div class="section-head-right">
          <p class="t-body">
            Change the destination to <code class="inline-code">user@host:/path/</code>
            for an SSH upload. Put the remote path first to download.
          </p>
        </div>
      </div>

      <div class="terminal-shell">
        <div class="terminal-chrome">
          <div class="terminal-lights"><span/><span/><span/></div>
          <div class="t-mono-sm">zsh · {bcmrProduct.title} {String(bcmrProduct.version ?? '').replace(/^v/, '')}</div>
          <div class="t-mono-sm" style="color: var(--steel-5);">command examples</div>
        </div>
        <div class="terminal-body">
          <CommandStream client:visible lines={terminalScript} />
        </div>
      </div>
    </section>

    <section class="home-section home-principles">
      <div class="section-head">
        <div class="section-head-left">
          <div class="t-small">§ 03 · features</div>
          <h2 class="t-h1 lower">transfer<br/>options.</h2>
        </div>
      </div>

      <div class="principles-grid">
        {features.map((it) => (
          <div class="principle">
            <div class="principle-n t-mono">{it.n}</div>
            <div class="principle-title t-h3 lower">{it.t}</div>
            <div class="principle-d">{it.d}</div>
            <div class="principle-mark">
              {it.mark === 'sq' && <div style={`width: 14px; height: 14px; background: ${it.color};`} />}
              {it.mark === 'ci' && <div style={`width: 14px; height: 14px; border-radius: 50%; background: ${it.color};`} />}
              {it.mark === 'tr' && <div style={`width: 0; height: 0; border-left: 8px solid transparent; border-right: 8px solid transparent; border-bottom: 14px solid ${it.color};`} />}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="home-cta">
      <div class="cta-inner">
        <div class="t-small" style="color: var(--c-steel-3);">§ 04 · begin</div>
        <h2 class="t-display lower" style="color: var(--c-paper-pure);">
          <BlockReveal client:visible delay={200} color="var(--yellow)">copy.</BlockReveal><br/>
          <BlockReveal client:visible delay={700} color="var(--red)">verify.</BlockReveal><br/>
          <BlockReveal client:visible delay={1200} color="var(--blue)">resume.</BlockReveal>
        </h2>
        <div class="cta-buttons">
          <a class="btn-block" style="background: var(--c-paper-pure); color: var(--c-ink-0); border-color: var(--c-paper-pure);" href={bcmrProduct.href('/install')}>
            install bcmr ↳
          </a>
          <a class="btn-block" style="background: transparent; color: var(--c-paper-pure); border-color: var(--c-paper-pure);" href={bcmrProduct.href('/docs/getting-started')}>
            read docs
          </a>
        </div>
        <div class="cta-small t-mono-sm">
          Apache-2.0
        </div>
      </div>
    </section>

    <Footer product={bcmrProduct} locale="en" languages={bcmrProduct.pageLanguages('en', '/', ['en', 'zh', 'zh-Hant'])} />
  </div>
</DefaultLayout>
