---
import WorkbenchEntry from '../../components/workbench/WorkbenchEntry.astro';
import DefaultLayout from '@snaix/docs-theme/layouts/DefaultLayout.astro';
import TopBar from '@snaix/docs-theme/components/TopBar.astro';
import Footer from '@snaix/docs-theme/components/Footer.astro';
import { BlockReveal, InstallTabs } from '@snaix/docs-theme';
import type { InstallStep } from '@snaix/docs-theme';
import { product } from '../../lib/product.ts';

const bcmrProduct = product('bcmr');

const versionBare = bcmrProduct.version.replace(/^v/, '');

const steps: InstallStep[] = [
  {
    title: 'verify',
    description: `confirm the binary is on your $PATH; compare its reported version with the published release (${bcmrProduct.version}).`,
    panelLabel: 'verification',
    script: [
      { type: 'prompt', text: `${bcmrProduct.title} --version` },
      { type: 'out',    text: `expected version: ${versionBare} · your build details may differ`, pause: 160 },
    ],
  },
  {
    title: 'first copy',
    description: 'copy a directory with BLAKE3 readback verification, then compare it with the source. example commands; output depends on your files.',
    panelLabel: 'first-copy',
    script: [
      { type: 'prompt', text: 'bcmr copy --recursive --verify ./photos/ ~/Backup/' },
      { type: 'out',    text: 'copies into ~/Backup/photos/ and verifies copied content', pause: 160 },
      { type: 'prompt', text: 'bcmr check --recursive ./photos/ ~/Backup/', pause: 240 },
      { type: 'out',    text: 'compares size and mtime; hashes size-matched files when mtimes differ', pause: 160 },
    ],
    footer: { href: '/bcmr/docs/getting-started', label: 'read the full walkthrough →' },
  },
];
---
<DefaultLayout title="bcmr · install">
  <div class="page install">
    <TopBar
      brand={bcmrProduct.title}
      version={bcmrProduct.version}
      current="install"
      githubHref={bcmrProduct.githubUrl}
      nav={bcmrProduct.nav()}
    />

    <WorkbenchEntry href="/workbench/setup/?tool=bcmr" label="Get a guided setup" description="Choose your system, find installation steps and troubleshoot common problems." />

    <section class="install-hero">
      <div class="t-small" style="color: var(--red);">§ install</div>
      <h1 class="install-title lower">
        <BlockReveal client:load>four</BlockReveal> <BlockReveal client:load color="var(--red)" delay={300}>ways</BlockReveal><br/>
        <BlockReveal client:load color="var(--blue)" delay={600}>in.</BlockReveal>
      </h1>
      <p class="t-body" style="margin-top: 24px; max-width: 560px;">
        bcmr is a command-line tool for local and SSH file operations.
        choose an installation method, check the installed version, then
        try a copy with BLAKE3 readback verification.
      </p>
    </section>

    <InstallTabs client:load options={bcmrProduct.install} steps={steps} />

    <Footer product={bcmrProduct} locale="en" languages={bcmrProduct.pageLanguages('en', '/', ['en'])} />
  </div>
</DefaultLayout>
