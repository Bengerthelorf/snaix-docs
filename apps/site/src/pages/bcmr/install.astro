---
import WorkbenchEntry from '../../components/workbench/WorkbenchEntry.astro';
import DefaultLayout from '@snaix/docs-theme/layouts/DefaultLayout.astro';
import TopBar from '@snaix/docs-theme/components/TopBar.astro';
import Footer from '@snaix/docs-theme/components/Footer.astro';
import { BlockReveal, InstallTabs } from '@snaix/docs-theme';
import type { InstallStep } from '@snaix/docs-theme';
import { product } from '../../lib/product.ts';

const bcmrProduct = product('bcmr');

const steps: InstallStep[] = [
  {
    title: 'check the version',
    description: 'Run bcmr --version to check the installation.',
    panelLabel: 'verification',
    script: [
      { type: 'prompt', text: `${bcmrProduct.title} --version` },
    ],
  },
  {
    title: 'first copy',
    description: 'Copy a directory and verify its contents with BLAKE3.',
    panelLabel: 'first-copy',
    script: [
      { type: 'prompt', text: 'bcmr copy --recursive --verify ./photos/ ~/Backup/' },
    ],
    footer: { href: '/bcmr/docs/getting-started', label: 'read the full walkthrough →' },
  },
];
---
<DefaultLayout title="bcmr · install">
  <div class="page install">
    <TopBar
      brand={bcmrProduct.title}
      version={bcmrProduct.version}
      current="install"
      githubHref={bcmrProduct.githubUrl}
      nav={bcmrProduct.nav()}
    />

    <WorkbenchEntry href="/workbench/setup/?tool=bcmr" label="Get a guided setup" description="Select your system and installation method." />

    <section class="install-hero">
      <div class="t-small" style="color: var(--red);">§ install</div>
      <h1 class="install-title lower">
        <BlockReveal client:load>install</BlockReveal><br/>
        <BlockReveal client:load color="var(--blue)" delay={300}>bcmr.</BlockReveal>
      </h1>
      <p class="t-body" style="margin-top: 24px; max-width: 560px;">
        Choose an installation method, then run your first verified copy.
      </p>
    </section>

    <InstallTabs client:load options={bcmrProduct.install} steps={steps} />

    <Footer product={bcmrProduct} locale="en" languages={bcmrProduct.pageLanguages('en', '/', ['en'])} />
  </div>
</DefaultLayout>
