---
import DefaultLayout from '@snaix/docs-theme/layouts/DefaultLayout.astro';
import { productPresentations } from '../data/site-static.ts';
import '@snaix/docs-theme/styles/design-system.css';
---
<DefaultLayout title="About · snaix.homes" description="Four open-source projects: bcmr, pikpaktui, IconChanger and Claudit.">
  <div class="page about ds-page">
    <nav class="ds-nav">
      <a href="/" class="ds-nav-home">← snaix.homes</a>
      <div class="ds-nav-links"><a href="/workbench/">Workbench</a><a href="/design-system/">Design language</a></div>
    </nav>
    <header class="ds-mast">
      <h1 class="ds-mast-title t-display">About the tools.</h1>
      <p class="ds-mast-sub">Installation, documentation and interactive examples for four open-source projects.</p>
    </header>
    <section class="credits-grid" aria-label="Projects">
      {productPresentations.map(p => <article class="credit">
        <h2 class="credit-name"><a href={p.href}>{p.name}</a></h2>
        <p>{p.descriptionOverride}</p>
        <div class="about-links"><a href={`${p.href}install`}>Install</a><a href={`${p.href}docs/getting-started`}>Docs</a><a href={`https://github.com/${p.repo}`}>Source</a></div>
      </article>)}
    </section>
  </div>
</DefaultLayout>
<style>
  .about { padding-block-end: 80px; }
  .credit h2 { margin-top: 0; }
  .credit p { font-size: 15px; line-height: 1.7; color: var(--fg-muted); }
  .about-links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 24px; font-size: 13px; }
  .about-links a { text-decoration: underline; text-underline-offset: 3px; }
</style>
