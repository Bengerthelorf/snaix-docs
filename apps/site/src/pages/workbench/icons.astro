---
import WorkbenchLayout from '../../layouts/WorkbenchLayout.astro';
import IconLibraryDemo from '../../components/workbench/IconLibraryDemo';
---
<WorkbenchLayout title="Replace an app icon." description="Choose an app, browse community icons, then preview and apply." current="icons" eyebrow="IconChanger">
  <IconLibraryDemo client:load />
  <noscript><p class="wb-note">Enable JavaScript to browse the sample library and try an icon replacement. You can also <a href="/iconchanger/install">install IconChanger</a> or <a href="/iconchanger/docs/getting-started">read the guide</a>.</p></noscript>
</WorkbenchLayout>
