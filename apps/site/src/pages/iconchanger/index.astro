---
import WorkbenchEntry from '../../components/workbench/WorkbenchEntry.astro';
import DefaultLayout from '@snaix/docs-theme/layouts/DefaultLayout.astro';
import TopBar from '@snaix/docs-theme/components/TopBar.astro';
import Footer from '@snaix/docs-theme/components/Footer.astro';
import IcMacWindow from '@snaix/docs-theme/components/IcMacWindow.astro';
import { BlockReveal, Scramble, Typewriter } from '@snaix/docs-theme';
import '@snaix/docs-theme/styles/iconchanger.css';
import { product } from '../../lib/product.ts';

const iconchanger = product('iconchanger');

const nav = [
  { id: 'home',      label: 'overview',  href: iconchanger.href('/') },
  { id: 'feat',      label: 'features',  href: '#features' },
  { id: 'sources',   label: 'workflow',  href: '#sources' },
  { id: 'docs',      label: 'docs',      href: iconchanger.href('/docs/getting-started') },
  { id: 'commands',  label: 'cli',       href: iconchanger.href('/commands') },
  { id: 'install',   label: 'install',   href: iconchanger.href('/install') },
  { id: 'changelog', label: 'changelog', href: iconchanger.href('/changelog') },
];

const sources = [
  { k: '01', h: 'online search', d: 'Search macosicons.com by app name. Add its API key in Settings → Advanced.' },
  { k: '02', h: 'local images', d: 'Choose a PNG, JPEG or ICNS file from your Mac.' },
  { k: '03', h: 'folder icons', d: 'Add folders to the sidebar and give them custom icons.' },
  { k: '04', h: 'favorites', d: 'Save icons to revisit when changing another app or folder.' },
  { k: '05', h: 'search aliases', d: 'Map an app or folder name to a search term, such as Photoshop.' },
  { k: '06', h: 'config export', d: 'Move aliases, cached icons and settings between Macs with import and export.' },
];
---
<DefaultLayout title={`${iconchanger.title} — ${iconchanger.tagline}`}>
  <div class="page ic-body">
    <TopBar
      brand={iconchanger.title}
      version={iconchanger.version}
      current="home"
      githubHref={iconchanger.githubUrl}
      nav={nav}

    >
      <Fragment slot="logo">
        <rect x="2"  y="2"  width="17" height="17" rx="4" fill="var(--red)" />
        <rect x="21" y="2"  width="17" height="17" rx="4" fill="var(--yellow)" />
        <rect x="2"  y="21" width="17" height="17" rx="4" fill="var(--blue)" />
        <rect x="21" y="21" width="17" height="17" rx="4" fill="var(--ink)" />
      </Fragment>
    </TopBar>

    <WorkbenchEntry href="/workbench/icons/" label="Try the icon studio" description="Preview an image on an app, a folder and the Dock." />

    <section class="ic-hero">
      <div class="ic-hero-top rule-b">
        <span class="t-mono-sm">iconchanger / macos native</span>
        <span class="t-mono-sm">apps · folders · auto-restore</span>
        <span class="t-mono-sm">{iconchanger.version} · {iconchanger.releaseDate}</span>
      </div>

      <div class="ic-hero-grid">
        <div class="ic-hero-left">
          <div class="ic-hero-eyebrow">
            <span class="t-small">§ 01 · overview</span>
            <span class="t-mono-sm" style="color: var(--steel-5);">
              <Typewriter client:visible text="// reapply your icons after app updates." speed={24} delay={300} />
            </span>
          </div>
          <h1 class="ic-hero-title lower">
            <span class="hl-line"><BlockReveal client:visible delay={300} duration={520} color="var(--red)">change</BlockReveal></span>
            <span class="hl-line"><BlockReveal client:visible delay={700} duration={520} color="var(--yellow)">app</BlockReveal></span>
            <span class="hl-line em-red"><BlockReveal client:visible delay={1100} duration={520} color="var(--blue)">icons.</BlockReveal></span>
          </h1>
          <p class="ic-lede">
            Replace app and folder icons with local images or icons from
            <a class="link-u" href="https://macosicons.com">macosicons.com</a>.
            Cache your choices and reapply them after app updates, on a
            schedule, or from the CLI.
          </p>
          <div class="ic-cta">
            <a class="btn-block" href="#install">↳ download for macos</a>
            <a class="btn-block is-ghost" href="#features">read more</a>
            <span class="ic-cta-meta">
              ⌘ <span>requires macos 13+</span>
            </span>
          </div>
        </div>

        <aside class="ic-hero-right">
          <IcMacWindow />
        </aside>
      </div>

      <div class="ic-ribbon">
        <div class="item">
          <span class="t-small">01</span>
          <div class="lbl"><Scramble client:visible text="macosicons.com" delay={200} /></div>
          <div class="sub">Search the community library by app name or your own alias.</div>
        </div>
        <div class="item">
          <span class="t-small">02</span>
          <div class="lbl"><Scramble client:visible text="dock preview" delay={320} /></div>
          <div class="sub">Preview custom icons together in the app’s Dock view.</div>
        </div>
        <div class="item">
          <span class="t-small">03</span>
          <div class="lbl"><Scramble client:visible text="per-app revert" delay={440} /></div>
          <div class="sub">Remove a custom icon with Restore Default.</div>
        </div>
        <div class="item">
          <span class="t-small">04</span>
          <div class="lbl"><Scramble client:visible text="auto-restore" delay={560} /></div>
          <div class="sub">Reapply cached icons on a schedule or when apps update.</div>
        </div>
      </div>
    </section>

    <section class="ic-section" id="features">
      <div class="ic-section-head">
        <div class="lhs">
          <div class="t-small">§ 02 · features</div>
          <h2 class="t-h1 lower">choose.<br />apply.<br />restore.</h2>
        </div>
        <div class="rhs">
          <p class="t-body">
            Set icons in the app or CLI. Enable background restoration to
            reapply your cached choices when an update resets them.
          </p>
        </div>
      </div>
      <div class="ic-features">
        <div class="col">
          <div class="n">01 · browse</div>
          <h3 class="lower">find an icon.</h3>
          <p>
            Search macosicons.com by app name or alias. Save favorites
            and preview your selection in the Dock view.
          </p>
          <div class="mark" />
        </div>
        <div class="col">
          <div class="n">02 · local</div>
          <h3 class="lower">use a local image.</h3>
          <p>
            Choose a <code>.icns</code>, <code>.png</code>, or <code>.jpg</code>
            file for an app or folder. The CLI’s <code>set-icon</code>
            command applies a local image from a script.
          </p>
          <div class="mark" />
        </div>
        <div class="col">
          <div class="n">03 · restore</div>
          <h3 class="lower">keep your choices.</h3>
          <p>
            Enable scheduled restoration or app-update checks to reapply
            cached custom icons. Run <code>iconchanger restore</code>
            for a manual batch restoration.
          </p>
          <div class="mark" />
        </div>
      </div>
    </section>

    <section class="ic-section" id="sources">
      <div class="ic-section-head">
        <div class="lhs">
          <div class="t-small">§ 03 · workflow</div>
          <h2 class="t-h1 lower">choose<br />and<br />reuse.</h2>
        </div>
        <div class="rhs">
          <p class="t-body">
            Reuse icons with favorites, improve searches with aliases,
            and export your configuration for another Mac.
          </p>
        </div>
      </div>
      <div class="ic-sources">
        {sources.map((s) => (
          <div class="ic-src">
            <div class="k">{s.k}</div>
            <div class="h lower">{s.h}</div>
            <div class="d">{s.d}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="ic-section">
      <div class="ic-metrics">
        <div class="ic-metric">
          <div class="n">swift</div>
          <div class="c">appkit · native</div>
        </div>
        <div class="ic-metric">
          <div class="n">cli</div>
          <div class="c">set · restore · export</div>
        </div>
        <div class="ic-metric">
          <div class="n">mac 13+</div>
          <div class="c">ventura or later</div>
        </div>
        <div class="ic-metric">
          <div class="n">auto</div>
          <div class="c">scheduled · after updates</div>
        </div>
      </div>
    </section>

    <section class="ic-cta-full" id="install">
      <div class="ic-cta-inner">
        <div class="t-small" style="color: rgba(255,255,255,0.7);">§ 04 · install</div>
        <h2 class="lower">
          <BlockReveal client:visible delay={200} color="var(--yellow)">set icons.</BlockReveal><br />
          <BlockReveal client:visible delay={700} color="var(--ink)">keep them.</BlockReveal>
        </h2>
        <div class="buttons">
          <a class="btn-block" style="background: var(--c-paper-pure); color: var(--c-ink-0); border-color: var(--c-paper-pure);" href={iconchanger.href('/install')}>
            download dmg ↳
          </a>
          <a class="btn-block" style="background: transparent; color: var(--c-paper-pure); border-color: var(--c-paper-pure);" href={`${iconchanger.githubUrl}/releases`}>
            release downloads
          </a>
        </div>
        <div class="t-mono-sm" style="margin-top: 28px; color: rgba(255,255,255,0.7);">
          macos 13 ventura or later · apple silicon & intel
        </div>
      </div>
    </section>

    <Footer product={iconchanger} locale="en" languages={iconchanger.pageLanguages('en', '/', ['en', 'zh', 'zh-Hant'])} />
  </div>
</DefaultLayout>
