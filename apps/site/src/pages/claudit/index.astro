---
import WorkbenchEntry from '../../components/workbench/WorkbenchEntry.astro';
import DefaultLayout from '@snaix/docs-theme/layouts/DefaultLayout.astro';
import TopBar from '@snaix/docs-theme/components/TopBar.astro';
import Footer from '@snaix/docs-theme/components/Footer.astro';
import ClDashMock from '@snaix/docs-theme/components/ClDashMock.astro';
import { BlockReveal, Scramble, Typewriter } from '@snaix/docs-theme';
import '@snaix/docs-theme/styles/claudit.css';
import { product } from '../../lib/product.ts';
import { getDemoDashboardPreview } from '../../lib/workbench/usage-demo-flow';

const claudit = product('claudit');
const dashboardPreview = getDemoDashboardPreview();

const nav = [
  { id: 'home',      label: 'overview',  href: claudit.href('/') },
  { id: 'audit',     label: 'audit',     href: '#audit' },
  { id: 'local',     label: 'data sources', href: '#local' },
  { id: 'docs',      label: 'docs',      href: claudit.href('/docs/getting-started') },
  { id: 'install',   label: 'install',   href: claudit.href('/install') },
  { id: 'changelog', label: 'changelog', href: claudit.href('/changelog') },
];
---
<DefaultLayout title={`${claudit.title} — ${claudit.tagline}`}>
  <div class="page cl-body">
    <TopBar
      brand={claudit.title}
      version={claudit.version}
      current="home"
      githubHref={claudit.githubUrl}
      nav={nav}

    >
      <Fragment slot="logo">
        <circle cx="20" cy="20" r="18" fill="var(--blue)" />
        <rect x="12" y="12" width="16" height="16" fill="var(--paper-pure)" />
        <rect x="14" y="14" width="5" height="5" fill="var(--red)" />
        <rect x="21" y="21" width="5" height="5" fill="var(--yellow)" />
      </Fragment>
    </TopBar>

    <WorkbenchEntry href="/workbench/usage/" label="Open the Claudit demo" description="Check Usage and Quota, then open a session conversation." />

    <section class="cl-hero">
      <div class="cl-hero-top rule-b">
        <span class="t-mono-sm">claudit / {claudit.tagline}</span>
        <span class="t-mono-sm">menu bar · swiftui · macos</span>
        <span class="t-mono-sm">{claudit.version} · {claudit.releaseDate}</span>
      </div>

      <div class="cl-hero-grid">
        <div class="cl-hero-left">
          <div class="cl-hero-eyebrow">
            <span class="t-small">§ 01 · overview</span>
            <span class="t-mono-sm" style="color: var(--steel-5);">
              <Typewriter client:visible text="// claude usage in your menu bar." speed={24} delay={300} />
            </span>
          </div>
          <h1 class="cl-hero-title lower">
            <span class="hl-line"><BlockReveal client:visible delay={300} color="var(--blue)">cost.</BlockReveal></span>
            <span class="hl-line"><BlockReveal client:visible delay={700} color="var(--red)">tokens.</BlockReveal></span>
            <span class="hl-line"><BlockReveal client:visible delay={1100} color="var(--yellow)">quota.</BlockReveal></span>
          </h1>
          <p class="cl-lede">
            Check today’s estimated cost and tokens from the macOS menu bar.
            Switch to Quota for 5-hour and 7-day usage and reset timers.
            Open the Dashboard to inspect project costs and session conversations.
          </p>
          <div class="cl-cta">
            <a class="btn-block" href="#install">↳ install {claudit.version}</a>
            <a class="btn-block is-ghost" href="#audit">what it shows</a>
            <span class="cl-cta-meta">
              ⌘ <span>brew install Bengerthelorf/tap/claudit</span>
            </span>
          </div>
        </div>

        <aside class="cl-hero-right">
          <ClDashMock snapshot={dashboardPreview} />
        </aside>
      </div>

      <div class="cl-ribbon">
        <div class="item">
          <span class="t-small">01</span>
          <div class="lbl"><Scramble client:visible text="local logs" delay={200} /></div>
          <div class="sub">Parses Claude Code and OpenClaw JSONL usage records.</div>
        </div>
        <div class="item">
          <span class="t-small">02</span>
          <div class="lbl"><Scramble client:visible text="per-project" delay={320} /></div>
          <div class="sub">Break down estimated cost and tokens by project, model and day.</div>
        </div>
        <div class="item">
          <span class="t-small">03</span>
          <div class="lbl"><Scramble client:visible text="session browser" delay={440} /></div>
          <div class="sub">Search conversations and inspect thinking blocks and tool calls.</div>
        </div>
        <div class="item">
          <span class="t-small">04</span>
          <div class="lbl"><Scramble client:visible text="multi-device" delay={560} /></div>
          <div class="sub">Combine local and remote usage through configured SSH hosts.</div>
        </div>
      </div>
    </section>

    <section class="cl-section" id="audit">
      <div class="cl-section-head">
        <div class="lhs">
          <div class="t-small">§ 02 · what it shows</div>
          <h2 class="t-h1 lower">from total<br />to transcript.</h2>
        </div>
        <div class="rhs">
          <p class="t-body">
            Open the Dashboard from the menu bar. Compare projects and
            models, then select a session to read its conversation and tool calls.
          </p>
        </div>
      </div>
      <div class="cl-audit">
        <div class="col">
          <div class="n">01 · spend</div>
          <h3 class="lower">cost by project.</h3>
          <p>
            Estimates use model prices and logged input, output, cache-read
            and cache-write tokens. Export usage records as CSV or JSON.
          </p>
          <div class="mark" />
        </div>
        <div class="col">
          <div class="n">02 · use</div>
          <h3 class="lower">usage over time.</h3>
          <p>
            Inspect hourly, weekly and monthly heatmaps, compare token
            usage by model, and see which tools your sessions call.
          </p>
          <div class="mark" />
        </div>
        <div class="col">
          <div class="n">03 · sessions</div>
          <h3 class="lower">read a session again.</h3>
          <p>
            Read user and assistant messages, expand thinking blocks and
            tool calls, and search the conversation with <code>⌘F</code>.
          </p>
          <div class="mark" />
        </div>
      </div>
    </section>

    <section class="cl-section" id="local">
      <div class="cl-section-head">
        <div class="lhs">
          <div class="t-small">§ 03 · data sources</div>
          <h2 class="t-h1 lower">logs.<br />quota.<br />devices.</h2>
        </div>
        <div class="rhs">
          <p class="t-body">
            Usage comes from JSONL files. Account quota and optional
            Console billing are fetched from Anthropic. Remote devices
            are read through SSH.
          </p>
        </div>
      </div>
      <div class="cl-local">
        <h3 class="lower">inspect logs.<br />track limits.<br />add devices.</h3>
        <ul>
          <li><b>logs</b>Claude Code records under <code>~/.claude</code> and OpenClaw session directories.</li>
          <li><b>quota</b>5-hour and 7-day utilization, with reset timers and authenticated Claude access.</li>
          <li><b>devices</b>SSH collection from a host alias or user@host, with cached usage records.</li>
          <li><b>billing</b>Connect an Anthropic Console session for spend, credits and per-key usage.</li>
          <li><b>export</b>Save usage records as CSV or JSON.</li>
          <li><b>alerts</b>Set quota and budget thresholds for system notifications or configured webhooks.</li>
        </ul>
      </div>
    </section>

    <section class="cl-section">
      <div class="cl-metrics">
        <div class="cl-metric">
          <div class="n">swift</div>
          <div class="c">swiftui · appkit</div>
        </div>
        <div class="cl-metric">
          <div class="n">mac 15+</div>
          <div class="c">min · menu bar native</div>
        </div>
        <div class="cl-metric">
          <div class="n">jsonl</div>
          <div class="c">claude code · openclaw</div>
        </div>
        <div class="cl-metric">
          <div class="n">ssh</div>
          <div class="c">remote usage · sessions</div>
        </div>
      </div>
    </section>

    <section class="cl-cta-full" id="install">
      <div class="cl-cta-inner">
        <div class="t-small" style="color: rgba(255,255,255,0.7);">§ 04 · install</div>
        <h2 class="lower">
          <BlockReveal client:visible delay={200} color="var(--yellow)">inspect usage.</BlockReveal><br />
          <BlockReveal client:visible delay={700} color="var(--red)">track quota.</BlockReveal>
        </h2>
        <div class="buttons">
          <a class="btn-block" style="background: var(--c-paper-pure); color: var(--c-ink-0); border-color: var(--c-paper-pure);" href={claudit.href('/install')}>
            brew install claudit ↳
          </a>
          <a class="btn-block" style="background: transparent; color: var(--c-paper-pure); border-color: var(--c-paper-pure);" href={`${claudit.githubUrl}/releases`}>
            download dmg
          </a>
        </div>
        <div class="t-mono-sm" style="margin-top: 28px; color: rgba(255,255,255,0.7);">
          macos 15 or later · apple silicon & intel
        </div>
      </div>
    </section>

    <Footer product={claudit} locale="en" languages={claudit.pageLanguages('en', '/', ['en'])} />
  </div>
</DefaultLayout>
