---
import WorkbenchEntry from '../../components/workbench/WorkbenchEntry.astro';
import DefaultLayout from '@snaix/docs-theme/layouts/DefaultLayout.astro';
import TopBar from '@snaix/docs-theme/components/TopBar.astro';
import Footer from '@snaix/docs-theme/components/Footer.astro';
import { BlockReveal, InstallTabs } from '@snaix/docs-theme';
import { product } from '../../lib/product.ts';

const claudit = product('claudit');
---
<DefaultLayout title={`${claudit.title} · install`}>
  <div class="page install">
    <TopBar
      brand={claudit.title}
      version={claudit.version}
      current="install"
      githubHref={claudit.githubUrl}
      nav={claudit.nav()}
    />

    <WorkbenchEntry href="/workbench/setup/?tool=claudit" label="Get a guided setup" description="Installation, usage logs and quota sign-in." />

    <section class="install-hero">
      <div class="t-small" style="color: var(--blue);">§ install</div>
      <h1 class="install-title lower">
        <BlockReveal client:load>two</BlockReveal> <BlockReveal client:load color="var(--red)" delay={300}>ways</BlockReveal><br/>
        <BlockReveal client:load color="var(--blue)" delay={600}>in.</BlockReveal>
      </h1>
      <p class="t-body" style="margin-top: 24px; max-width: 560px;">
        Install with Homebrew or the DMG on macOS 15 or later. Claudit
        reads Claude Code and OpenClaw logs; account quota uses
        authenticated Claude access.
      </p>
    </section>

    <InstallTabs client:load options={claudit.install} />

    <section class="install-after">
      <div class="install-after-grid">
        <div>
          <div class="t-small" style="color: var(--blue);">§ next</div>
          <h2 class="t-h2 lower" style="margin-top: 8px;">launch &amp;<br/>open the menu bar.</h2>
        </div>
        <div>
          <ol class="install-after-steps">
            <li><span class="step-key">open</span><span class="step-desc">launch Claudit from Spotlight or Applications.</span></li>
            <li><span class="step-key">setup</span><span class="step-desc">in the first-run wizard, connect Claude credentials and verify quota access, or choose Skip Setup for local usage.</span></li>
            <li><span class="step-key">menu bar</span><span class="step-desc">switch between Usage for estimated cost and tokens, and Quota for utilization and reset timers.</span></li>
            <li><span class="step-key">dashboard</span><span class="step-desc">open the Dashboard from the popover, then select a session to read its conversation and tool calls.</span></li>
          </ol>
          <p style="margin-top: 18px;">
            see the <a class="link-u" href="/claudit/docs/getting-started">getting started guide</a> for
            dashboard navigation and remote-machine setup.
          </p>
        </div>
      </div>
    </section>

    <Footer product={claudit} locale="en" />
  </div>
</DefaultLayout>

