---
import ThemeInit from './ThemeInit.astro';
import FontLinks from './FontLinks.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

import '../styles/tokens.css';
import '../styles/theme.css';
import '../styles/motion.css';
import '../styles/layout.css';
import '../styles/pages.css';
import '../styles/directives.css';
import '../styles/portal.css';
import '../styles/home.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  favicon?: string;
  ogImage?: string;
}
const { title, description, bodyClass, lang = 'en', dir, favicon, ogImage } = Astro.props;
/* arabic, hebrew, persian, urdu — flip layout when explicit or when the
   lang code is known rtl. */
const resolvedDir = dir ?? (/^(ar|he|fa|ur)\b/i.test(lang) ? 'rtl' : undefined);
/* Pick a per-product favicon + og card by URL path. Portal / design-system /
   about / 404 all fall through to the universal snaix mark. */
const productSlug = Astro.url.pathname.match(/^\/(bcmr|pikpaktui|iconchanger|claudit)\//)?.[1];
const faviconHref = favicon ?? (productSlug ? `/icons/${productSlug}.svg` : '/icons/snaix.svg');
const ogImageHref = ogImage ?? (productSlug ? `/og/${productSlug}.png` : '/og/snaix.png');
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://app.snaix.homes').toString();
const ogImageAbs = new URL(ogImageHref, Astro.site ?? 'https://app.snaix.homes').toString();
const ogDescription = description ?? 'small tools, big years. four open-source tools — cli, tui, macos native — across one bench.';
---
<!doctype html>
<html lang={lang} dir={resolvedDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="snaix.homes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageAbs} />
    <ThemeInit />
    <FontLinks />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <ThemeToggle />
    <script>
      import './layout-behavior';
    </script>
  </body>
</html>
