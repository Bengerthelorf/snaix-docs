---
import ThemeInit from './ThemeInit.astro';
import FontLinks from './FontLinks.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { snaixConfig } from 'virtual:snaix-config';
import { resolveSiteMetadata } from '../utils/site-metadata';

import '../styles/tokens.css';
import '../styles/theme.css';
import '../styles/motion.css';
import '../styles/layout.css';
import '../styles/pages.css';
import '../styles/directives.css';
import '../styles/portal.css';
import '../styles/home.css';
import '../styles/viewport-segments.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  favicon?: string;
  ogImage?: string;
}
const { title, description, bodyClass, lang = 'en', dir, favicon, ogImage } = Astro.props;
/* arabic, hebrew, persian, urdu — flip layout when explicit or when the
   lang code is known rtl. */
const resolvedDir = dir ?? (/^(ar|he|fa|ur)\b/i.test(lang) ? 'rtl' : undefined);
const metadata = resolveSiteMetadata({
  pathname: Astro.url.pathname,
  site: Astro.site,
  base: import.meta.env.BASE_URL,
  brand: snaixConfig.brand,
  products: snaixConfig.products,
  description,
  favicon,
  ogImage,
});
---
<!doctype html>
<html lang={lang} dir={resolvedDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="icon" href={metadata.favicon} />
    {metadata.canonical && <link rel="canonical" href={metadata.canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={metadata.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metadata.description} />
    {metadata.canonical && <meta property="og:url" content={metadata.canonical} />}
    {metadata.ogImage && <meta property="og:image" content={metadata.ogImage} />}
    <meta name="twitter:card" content={metadata.ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metadata.description} />
    {metadata.ogImage && <meta name="twitter:image" content={metadata.ogImage} />}
    <ThemeInit />
    <FontLinks />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <ThemeToggle locale={lang} />
    <script>
      import './viewport-segments';
      import './layout-behavior';
    </script>
  </body>
</html>
