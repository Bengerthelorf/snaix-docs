<script>
  let engine: Promise<typeof import('mermaid')> | undefined;
  let running = false;
  let requested = false;

  async function renderDiagrams() {
    requested = true;
    if (running) return;
    running = true;
    try {
      while (requested) {
        requested = false;
        const nodes = Array.from(document.querySelectorAll<HTMLElement>('pre.mermaid[data-source="snaix-mermaid"]'));
        if (!nodes.length) continue;
        for (const node of nodes) {
          node.dataset.src ??= node.textContent ?? '';
          node.tabIndex = 0;
          node.setAttribute('role', 'region');
          node.setAttribute('aria-label', 'Diagram source');
        }
        engine ??= import('mermaid').catch((error) => { engine = undefined; throw error; });
        const { default: mermaid } = await engine;
        const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default';
        mermaid.initialize({ startOnLoad: false, theme, securityLevel: 'strict' });
        for (const node of nodes) {
          node.removeAttribute('data-processed');
          node.textContent = node.dataset.src ?? '';
        }
        try {
          await mermaid.run({ nodes });
          nodes.forEach((node) => {
            const svg = node.querySelector('svg');
            if (svg) {
              const width = svg.viewBox.baseVal.width;
              if (Number.isFinite(width) && width > 0) {
                // Preserve the diagram's intended text size. The surrounding
                // region scrolls instead of shrinking labels to phone width.
                svg.style.width = `${width}px`;
                svg.style.maxWidth = 'none';
                svg.style.height = 'auto';
                svg.style.display = 'block';
              }
            }
            node.setAttribute('aria-label', 'Diagram, scroll horizontally to view');
            node.dataset.rendered = 'true';
          });
        } catch (error) {
          // Keep the original diagram readable when a document has bad syntax.
          nodes.forEach((node) => {
            node.textContent = node.dataset.src ?? '';
            node.removeAttribute('data-processed');
            node.removeAttribute('data-rendered');
          });
          console.warn('[diagram] could not render; showing source', error);
        }
      }
    } catch (error) {
      console.warn('[diagram] renderer unavailable; showing source', error);
    } finally { running = false; }
  }

  void renderDiagrams();
  new MutationObserver(() => { void renderDiagrams(); }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
