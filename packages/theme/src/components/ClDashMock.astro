---
interface Props {
  snapshot: {
    period: string;
    totals: { costCents: number; tokens: number; sessions: number; activeDays: number; inputTokens: number; outputTokens: number; cacheReadTokens: number; cacheWriteTokens: number };
    days: { date: string; costCents: number }[];
    models: { name: string; costCents: number }[];
    projects: { name: string; costCents: number }[];
    recentSessions: { id: string; time: string; project: string; model: string; costCents: number }[];
  };
}

const { snapshot } = Astro.props;
const number = new Intl.NumberFormat('en-US');
const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
const money = (cents: number) => usd.format(cents / 100);
const maxDailyCost = Math.max(1, ...snapshot.days.map((day) => day.costCents));
const maxSessionCost = Math.max(1, ...snapshot.recentSessions.map((session) => session.costCents));
const share = (cents: number) => snapshot.totals.costCents ? cents / snapshot.totals.costCents * 100 : 0;
const colors = ['var(--blue)', 'var(--red)', 'var(--yellow)', 'var(--ink)'];
const tokenRows = [
  ['Input', snapshot.totals.inputTokens],
  ['Output', snapshot.totals.outputTokens],
  ['Cache read', snapshot.totals.cacheReadTokens],
  ['Cache write', snapshot.totals.cacheWriteTokens],
] as const;
---
<div class="cl-dash">
  <div class="cl-dash-chrome">
    <span class="dot" />
    <span class="title">Claudit · Dashboard</span>
    <span class="status"><span class="live">Example data</span></span>
  </div>
  <div class="preview-period">{snapshot.period} · UTC</div>
  <div class="cl-dash-body">
    <div class="cl-cell">
      <div class="ch"><span class="t">estimated cost</span><span class="m">USD</span></div>
      <div class="cl-big is-blue">{money(snapshot.totals.costCents)}</div>
      <div class="cl-sub">{snapshot.totals.sessions} sessions · {snapshot.totals.activeDays} active days</div>
      <dl class="preview-token-list"><div><dt>Total tokens</dt><dd>{number.format(snapshot.totals.tokens)}</dd></div>{tokenRows.map(([label, value]) => <div><dt>{label}</dt><dd>{number.format(value)}</dd></div>)}</dl>
    </div>

    <div class="cl-cell">
      <div class="ch"><span class="t">daily cost</span><span class="m">USD</span></div>
      <div class="cl-bars" role="img" aria-label={snapshot.days.map((day) => `${day.date}: ${money(day.costCents)}`).join('; ')}>
        {snapshot.days.map((day) => <div class="bar" style={`height: ${day.costCents / maxDailyCost * 100}%;`} />)}
      </div>
      <div class="cl-bars-x"><span>{snapshot.days[0].date.slice(5)}</span><span>{snapshot.days[snapshot.days.length - 1].date.slice(5)}</span></div>
    </div>

    <div class="cl-cell">
      <div class="ch"><span class="t">by model</span><span class="m">estimated cost</span></div>
      <div class="cl-mdl">{snapshot.models.map((model) => <div class="cl-mdl-row"><div class="n">{model.name}</div><div class="tr" aria-hidden="true"><div class="tr-f" style={`width: ${share(model.costCents)}%;`} /></div><div class="v">{money(model.costCents)}</div></div>)}</div>
    </div>

    <div class="cl-cell">
      <div class="ch"><span class="t">by project</span><span class="m">estimated cost</span></div>
      <div class="cl-legend">{snapshot.projects.map((project, index) => <div class="cl-legend-row"><span class="sw" style={`background: ${colors[index % colors.length]};`} /><span class="n">{project.name}</span><span class="v">{money(project.costCents)}</span></div>)}</div>
    </div>

    <div class="cl-cell col-span-2">
      <div class="ch"><span class="t">sessions</span><span class="m">latest {snapshot.recentSessions.length} of {snapshot.totals.sessions}</span></div>
      <div class="cl-sess">{snapshot.recentSessions.map((session) => <div class="cl-sess-row"><span class="t">{session.time}</span><span class="p">{session.project}</span><span class="m">{session.model}</span><span class="bar" style={`width: ${session.costCents / maxSessionCost * 100}%;`} aria-hidden="true" /><span class="cost">{money(session.costCents)}</span></div>)}</div>
    </div>
  </div>
</div>
<style>
  .preview-period { padding: 10px 14px; border-bottom: 1px solid var(--steel-3); font-size: 11px; color: var(--fg-muted); }
  .preview-token-list { display: grid; gap: 7px; margin: 20px 0 0; font-size: 11px; }
  .preview-token-list > div { display: flex; justify-content: space-between; gap: 12px; }
  .preview-token-list dt { color: var(--fg-muted); }
  .preview-token-list dd { margin: 0; font-variant-numeric: tabular-nums; }
  .cl-bars { margin-top: 24px; }
  .cl-mdl-row { grid-template-columns: minmax(0, 1fr) minmax(25px, 1fr) auto; }
  .cl-legend { display: grid; gap: 12px; }
  .cl-sess-row { grid-template-columns: 100px minmax(0, 1.4fr) minmax(0, 1fr) 50px 55px; }
  @container claudit-preview (max-width: 600px) {
    .cl-sess-row { grid-template-columns: 100px minmax(0, 1fr) 55px; }
    .cl-sess-row .m, .cl-sess-row .bar { display: none; }
  }
  @container claudit-preview (max-width: 360px) {
    .cl-sess-row { grid-template-columns: minmax(0, 1fr) 55px; }
    .cl-sess-row .p { grid-row: 2; grid-column: 1; }
    .cl-sess-row .cost { grid-row: 1; grid-column: 2; }
  }
</style>
