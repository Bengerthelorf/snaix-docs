---
/* Pagefind-powered docs search. the index lives at /pagefind/ (built by
   `pagefind --site dist`) and is loaded only on demand (first keystroke).
   desktop: a floating pill at top-right of docs content. mobile: full-
   width below the topbar. Cmd/Ctrl+K focuses it from anywhere. */
---
<div class="snx-search" data-search>
  <label class="snx-search__label">
    <span class="snx-search__kbd" aria-hidden="true">⌘K</span>
    <input
      type="search"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="docs-search-results"
      class="snx-search__input"
      placeholder="search docs"
      aria-label="search docs"
      autocomplete="off"
      spellcheck="false"
      data-search-input
    />
  </label>
  <div class="snx-search__panel" data-search-panel hidden>
    <ul id="docs-search-results" class="snx-search__results" role="listbox" aria-label="search results" data-search-results></ul>
    <div class="snx-search__empty" data-search-empty hidden>no matches.</div>
    <div class="snx-search__hint" role="status" data-search-hint>type to search · esc to close</div>
  </div>
</div>

<style>
  .snx-search {
    position: relative;
    font-family: var(--mono);
  }
  .snx-search__label {
    display: flex; align-items: stretch; gap: 0;
    border: 1px solid var(--ink);
    background: var(--paper-pure);
  }
  .snx-search__kbd {
    display: flex; align-items: center;
    padding: 0 10px;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--steel-5);
    background: var(--bg-raised);
    border-right: 1px solid var(--steel-3);
  }
  .snx-search__input {
    flex: 1;
    padding: 8px 12px;
    font: inherit;
    font-size: 13px;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--fg);
    min-width: 0;
  }
  .snx-search__input::placeholder { color: var(--steel-5); }
  .snx-search__input:focus { background: var(--paper); }

  .snx-search__panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0; right: 0;
    max-height: 60vh;
    overflow-y: auto;
    background: var(--paper-pure);
    border: 1px solid var(--ink);
    z-index: 20;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .snx-search__results { list-style: none; margin: 0; padding: 0; }
  .snx-search__results li { border-top: 1px solid var(--steel-3); }
  .snx-search__results li:first-child { border-top: 0; }
  .snx-search__results a {
    display: block;
    padding: 10px 14px;
    text-decoration: none;
    color: var(--ink);
    transition: background var(--t-fast);
  }
  .snx-search__results a:hover,
  .snx-search__results a.is-active { background: var(--ink); color: var(--paper-pure); }
  .snx-search__results a:hover .snx-search__result-excerpt,
  .snx-search__results a.is-active .snx-search__result-excerpt { color: var(--c-steel-3); }
  .snx-search__result-title {
    display: block;
    font-family: var(--sans);
    font-size: 14px; font-weight: 600;
    letter-spacing: -0.01em;
    text-transform: lowercase;
  }
  .snx-search__result-path {
    display: block;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel-5);
    margin-bottom: 4px;
  }
  .snx-search__result-excerpt {
    display: block;
    font-family: var(--sans);
    font-size: 12px;
    line-height: 1.5;
    color: var(--steel-7);
    margin-top: 4px;
  }
  .snx-search__result-excerpt mark {
    background: var(--c-yellow); color: var(--c-ink-0);
    padding: 0 2px;
  }

  .snx-search__empty,
  .snx-search__hint {
    padding: 12px 14px;
    font-size: 11px;
    color: var(--steel-5);
    letter-spacing: 0.06em;
  }
  .snx-search__empty { color: var(--red); }
</style>

<script>
  import { createSearchRunner, highlightExcerpt, type SearchItem } from './search-state';

  for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const panel = root.querySelector<HTMLElement>('[data-search-panel]');
    const list = root.querySelector<HTMLUListElement>('[data-search-results]');
    const empty = root.querySelector<HTMLElement>('[data-search-empty]');
    const hint = root.querySelector<HTMLElement>('[data-search-hint]');
    if (!input || !panel || !list || !empty || !hint) continue;
    let activeIdx = -1;
    let results: SearchItem[] = [];
    const show = () => { panel.hidden = false; input.setAttribute('aria-expanded', 'true'); };
    const hide = () => {
      panel.hidden = true;
      activeIdx = -1;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
    };
    const setActive = (index: number) => {
      activeIdx = index;
      for (const [i, link] of Array.from(list.querySelectorAll('a')).entries()) {
        link.classList.toggle('is-active', i === index);
        link.setAttribute('aria-selected', String(i === index));
        if (i === index) {
          input.setAttribute('aria-activedescendant', link.id);
          link.scrollIntoView({ block: 'nearest' });
        }
      }
    };
    const search = createSearchRunner(async () => {
      const base = import.meta.env.BASE_URL;
      const pagefind = await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
      await pagefind.init();
      return pagefind;
    }, (state) => {
      activeIdx = -1;
      results = state.items;
      input.removeAttribute('aria-activedescendant');
      input.setAttribute('aria-busy', String(state.loading));
      list.replaceChildren();
      empty.hidden = !state.query || state.loading || state.error || results.length > 0;
      hint.hidden = !!state.query && !state.loading && !state.error;
      hint.textContent = state.error ? 'search unavailable. type again to retry.'
        : state.loading ? 'searching…' : 'type to search · esc to close';
      results.forEach((result, index) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'presentation');
        const link = document.createElement('a');
        link.id = `${list.id}-${index}`;
        link.href = result.url;
        link.tabIndex = -1;
        link.setAttribute('role', 'option');
        link.setAttribute('aria-selected', 'false');
        const path = document.createElement('span');
        path.className = 'snx-search__result-path';
        path.textContent = `${result.url.split('/')[1] ?? ''} / ${result.meta?.section ?? 'docs'}`;
        const title = document.createElement('span');
        title.className = 'snx-search__result-title';
        title.textContent = result.meta?.title ?? result.url;
        const excerpt = document.createElement('span');
        excerpt.className = 'snx-search__result-excerpt';
        excerpt.innerHTML = highlightExcerpt(result.excerpt ?? '');
        link.append(path, title, excerpt);
        link.addEventListener('pointermove', () => setActive(index));
        li.append(link);
        list.append(li);
      });
    });
    input.addEventListener('focus', show);
    input.addEventListener('input', () => { show(); void search(input.value.trim()); });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault(); input.focus(); input.select();
      } else if (document.activeElement === input) {
        if (event.key === 'Escape') { hide(); input.blur(); }
        else if (!panel.hidden && results.length > 0) {
          if (event.key === 'ArrowDown') { event.preventDefault(); setActive((activeIdx + 1) % results.length); }
          else if (event.key === 'ArrowUp') { event.preventDefault(); setActive((activeIdx - 1 + results.length) % results.length); }
          else if (event.key === 'Enter' && activeIdx >= 0) {
            event.preventDefault(); list.querySelectorAll('a')[activeIdx]?.click();
          }
        }
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) hide();
    });
  }
</script>
