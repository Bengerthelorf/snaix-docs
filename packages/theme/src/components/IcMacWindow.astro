---
interface Props { imageSrc?: string; demoHref?: string; }
const { imageSrc = '/iconchanger/images/main-interface.png', demoHref = '/workbench/icons/' } = Astro.props;
---
<figure class="ic-product-shot">
  <a href={demoHref} aria-label="Try choosing a replacement icon">
    <img src={imageSrc} alt="IconChanger on macOS with an application sidebar and ready-made icons from macOSicons.com" width="2242" height="1468" decoding="async" />
  </a>
  <figcaption><span>IconChanger for macOS</span><a href={demoHref}>Try an icon replacement</a></figcaption>
</figure>
<style>
  .ic-product-shot { margin: 0; min-width: 0; border: 1px solid var(--border); box-shadow: 12px 12px 0 var(--red); background: var(--paper-pure); }
  .ic-product-shot > a { display: block; }
  img { display: block; width: 100%; height: auto; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; padding: 14px 16px; font-size: 11px; border-top: 1px solid var(--border-faint); }
  figcaption > span { color: var(--fg-muted); }
  figcaption > a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
</style>
